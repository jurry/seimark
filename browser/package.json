{
  "name": "seimark",
  "version": "0.1.0",
  "description": "Per-frame metadata in H.264 SEI for WebRTC senders and receivers",
  "keywords": ["webrtc", "h264", "sei", "whip", "whep", "encoded-transform", "timestamp", "latency", "mediamtx"],
  "license": "MIT",
  "author": "Jiri Mejzlik",
  "repository": { "type": "git", "url": "git+https://github.com/jurry/seimark.git", "directory": "browser" },
  "homepage": "https://github.com/jurry/seimark/tree/main/browser#readme",
  "bugs": "https://github.com/jurry/seimark/issues",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./webrtc": { "types": "./dist/webrtc/index.d.ts", "import": "./dist/webrtc/index.js" }
  },
  "typesVersions": { "*": { "webrtc": ["./dist/webrtc/index.d.ts"] } },
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "npm run build:worker && tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.webrtc.json",
    "build:worker": "node build/worker.mjs",
    "build": "npm run build:worker && tsc -p tsconfig.webrtc.json",
    "test": "npm run build:worker && node --test --experimental-strip-types test/*.test.ts",
    "demo": "node demo/serve.mjs",
    "demo:screenshot": "node demo/screenshot.mjs",
    "e2e": "npm run build && playwright test",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "esbuild": "^0.28.2",
    "@playwright/test": "^1.48.0"
  }
}
